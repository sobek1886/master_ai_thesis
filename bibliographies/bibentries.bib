  urldate = {2026-01-30},
  abstract = {Sign language, as a visual language, is inherently spatial and dynamic, characterized by various hand shapes, movements, facial expressions, and body postures. In real-world scenarios, sign language recognition (SLR) systems are deployed in diverse environments with varying lighting conditions, backgrounds, and user positions, and models trained on data from a single viewpoint often struggle to generalize effectively to new perspectives. To address these limitations, this paper focuses on cross-view SLR and proposes a synthetic view augmentation pipeline to facilitate SLR models learning viewpoint-invariant features during training, thereby improving their performance on unseen viewpoints. Additionally, we introduce the XV-SLR model, which incorporates multi-modality information further to enhance the robustness of cross-view sign language recognition. The proposed method achieves a top-1 accuracy of 56.87\% under the RGB setting and 57.97\% under the RGB-D setting and outperforms other approaches in the Cross-View Isolated Sign Language Recognition Challenge (CV-ISLR). Code is available at https://github.com/VIPL-SLP/XV-SLR.},
  isbn = {979-8-4007-1331-6},
  file = {/Users/piotr/Zotero/storage/85SBWPVQ/Peng et al. - 2025 - Synthetic View Augmentation for Sign Language Recognition.pdf}
}


@incollection{ilicAppearanceFreeAction2022,
  title = {Is {{Appearance Free Action Recognition Possible}}?},
  booktitle = {Computer {{Vision}} -- {{ECCV}} 2022},
  author = {Ilic, Filip and Pock, Thomas and Wildes, Richard P.},
  editor = {Avidan, Shai and Brostow, Gabriel and Ciss{\'e}, Moustapha and Farinella, Giovanni Maria and Hassner, Tal},
  year = 2022,
  volume = {13664},
  pages = {156--173},
  publisher = {Springer Nature Switzerland},
  address = {Cham},
  doi = {10.1007/978-3-031-19772-7_10},
  urldate = {2026-02-04},
  abstract = {Intuition might suggest that motion and dynamic information are key to video-based action recognition. In contrast, there is evidence that state-of-the-art deep-learning video understanding architectures are biased toward static information available in single frames. Presently, a methodology and corresponding dataset to isolate the effects of dynamic information in video are missing. Their absence makes it difficult to understand how well contemporary architectures capitalize on dynamic vs. static information. We respond with a novel Appearance Free Dataset (AFD) for action recognition. AFD is devoid of static information relevant to action recognition in a single frame. Modeling of the dynamics is necessary for solving the task, as the action is only apparent through consideration of the temporal dimension. We evaluated 11 contemporary action recognition architectures on AFD as well as its related RGB video. Our results show a notable decrease in performance for all architectures on AFD compared to RGB. We also conducted a complimentary study with humans that shows their recognition accuracy on AFD and RGB is very similar and much better than the evaluated architectures on AFD. Our results motivate a novel architecture that revives explicit recovery of optical flow, within a contemporary design for best performance on AFD and RGB.},
  isbn = {978-3-031-19771-0 978-3-031-19772-7},
  langid = {english},
  file = {/Users/piotr/Zotero/storage/2ZMYWSH9/Ilic et al. - 2022 - Is Appearance Free Action Recognition Possible.pdf}
}

